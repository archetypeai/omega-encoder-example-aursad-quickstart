# Copy to app-serving/.env only to change the defaults below. The API key and
# endpoint are read from the REPO's .env (ATAI_API_ENDPOINT, ATAI_API_KEY), the
# same file the Python stages use, and stay with the serving bridge: the browser
# never sees them.

# --- host ports ---------------------------------------------------------------
#
#   MQTT TCP  MQTT WS  Web
#   1893      9011     5183
#
# MQTT_PORT=1893
# PUBLIC_MQTT_TCP_PORT=1893
# PUBLIC_MQTT_WS_PORT=9011
# PACE=4             # replay speed: 1 = real time (100 rows/s), 4, or 16
